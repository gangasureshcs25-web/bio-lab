import numpy as np
import random

# Distance matrix for 5 cities
dist = np.array([
    [0,  2,  9, 10,  7],
    [2,  0,  6,  4,  3],
    [9,  6,  0,  8,  5],
    [10, 4,  8,  0,  6],
    [7,  3,  5,  6,  0]
], dtype=float)

n = len(dist)
num_ants = 10
iterations = 100
alpha = 1.0
beta = 2.0
rho = 0.5
Q = 100

# Initialize pheromones
pheromone = np.ones((n, n))
visibility = np.zeros_like(dist)
visibility[dist > 0] = 1 / dist[dist > 0]

best_route = None
best_distance = float("inf")

for iteration in range(iterations):
    routes = []
    lengths = []

    for ant in range(num_ants):
        start = random.randrange(n)
        route = [start]
        unvisited = set(range(n))
        unvisited.remove(start)

        while unvisited:
            current = route[-1]
            candidates = list(unvisited)

            weights = [
                pheromone[current, j] ** alpha
                * visibility[current, j] ** beta
                for j in candidates
            ]

            probabilities = np.array(weights) / sum(weights)
            next_city = random.choices(
                candidates, weights=probabilities, k=1
            )[0]

            route.append(next_city)
            unvisited.remove(next_city)

        # Return to the starting city
        route.append(start)

        length = sum(
            dist[route[i], route[i + 1]]
            for i in range(len(route) - 1)
        )

        routes.append(route)
        lengths.append(length)

        if length < best_distance:
            best_distance = length
            best_route = route.copy()

    # Evaporate pheromones
    pheromone *= (1 - rho)

    # Deposit pheromones
    for route, length in zip(routes, lengths):
        deposit = Q / length

        for i in range(len(route) - 1):
            a, b = route[i], route[i + 1]
            pheromone[a, b] += deposit
            pheromone[b, a] += deposit

print("Best route:", best_route)
print("Minimum distance:", best_distance)
